{
  "log": { "level": "info", "timestamp": true },
  "dns": {
    "servers": [
      { "tag": "dns_proxy", "type": "https", "server": "8.8.8.8", "path": "/dns-query", "detour": "🚀 节点选择" },
      { "tag": "dns_direct", "type": "https", "server": "223.5.5.5", "path": "/dns-query", "detour": "direct" },
      { "tag": "dns_fakeip", "type": "fakeip", "inet4_range": "198.18.0.0/15" }
